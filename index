  qty:{th:'จำนวน', mm:'အရေအတွက်', en:'Quantity'},
  unit:{th:'หน่วย', mm:'ယူနစ်', en:'Unit'},
  itemNote:{th:'หมายเหตุรายการนี้', mm:'ဤစာရင်း၏ မှတ်ချက်', en:'Note for this item'},
  notePh:{th:'เช่น ห่อที่ 5 ถุงขาด / ของขาด 2 ชิ้น', mm:'ဥပမာ - ၅ ထုပ် အိတ်ပေါက် / ၂ ခု လျော့', en:'e.g. bag 5 torn / 2 pcs short'},

  sumNone:{th:'ยังไม่มีรายการ', mm:'စာရင်း မရှိသေးပါ', en:'No items yet'},
