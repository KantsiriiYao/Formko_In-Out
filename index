  lFolder:{th:'📁 โฟลเดอร์รอบนี้ใน Google Drive', mm:'📁 Google Drive ဤအကြိမ် ဖိုင်တွဲ', en:'This shipment folder on Drive'},
  lBillFolder:{th:'📄 โฟลเดอร์รูปบิล', mm:'📄 ဘောက်ချာဓာတ်ပုံ ဖိုင်တွဲ', en:'Bill photos folder'},
  lGoodsFolder:{th:'📦 โฟลเดอร์รูปของ', mm:'📦 ကုန်ပစ္စည်းဓာတ်ပုံ ဖိုင်တွဲ', en:'Goods photos folder'},
  lSheet:{th:'📊 สรุปรอบนี้ (Sheet)', mm:'📊 အကျဉ်းချုပ် (Sheet)', en:'Summary sheet'},
  lPdf:{th:'📕 สรุปรอบนี้ (PDF)', mm:'📕 အကျဉ်းချုပ် (PDF)', en:'Summary PDF'},
  lMaster:{th:'🗂 ตารางรวมทุกรอบ', mm:'🗂 စုစုပေါင်းဇယား', en:'All shipments table'},
  sent:{th:'ส่งแล้ว ล้างร่างเรียบร้อย', mm:'ပို့ပြီးပါပြီ', en:'Submitted'},
  photos:{th:'รูป', mm:'ဓာတ်ပုံ', en:'photos'},

  errDate:{th:'กรุณาเลือกวันที่บิล', mm:'ဘောက်ချာရက်စွဲ ရွေးပါ', en:'Please choose the bill date'},
  errCarrier:{th:'กรุณาเลือกบริษัทขนส่ง CMT หรือ GCL', mm:'ပို့ဆောင်ရေးကုမ္ပဏီ CMT သို့ GCL ရွေးပါ', en:'Please choose CMT or GCL'},
  errWorker:{th:'กรุณากรอกชื่อผู้กรอก', mm:'သင့်အမည် ရေးပါ', en:'Please enter your name'},
  errItems:{th:'ยังไม่มีรายการสินค้า', mm:'ကုန်ပစ္စည်းစာရင်း မရှိသေးပါ', en:'No goods listed yet'},
  askBill:{th:'ยังไม่ได้แนบรูปบิล ต้องการส่งเลยหรือไม่?', mm:'ဘောက်ချာဓာတ်ပုံ မတွဲရသေးပါ — ပို့မလား?', en:'No bill photo attached. Submit anyway?'},
  errSend:{th:'ส่งไม่สำเร็จ', mm:'မအောင်မြင်ပါ — အချက်အလက် သိမ်းထားသည်၊ ထပ်ပို့ကြည့်ပါ', en:'Submit failed — draft kept, please try again'},
  errUrl:{th:'ยังไม่ได้ใส่ URL ของ Apps Script ในไฟล์ HTML', mm:'Apps Script URL မထည့်ရသေးပါ', en:'Apps Script URL is not set in the HTML file'}
};

/* หน่วย — value ที่บันทึกเป็นภาษาไทยเสมอ */
const UNITS = [
  {v:'ห่อ',   mm:'ထုပ်',   en:'Pack'},
  {v:'ม้วน',  mm:'လိပ်',   en:'Roll'},
  {v:'ชิ้น',  mm:'ခု',     en:'Piece'},
  {v:'กล่อง', mm:'ဘူး',    en:'Box'},
  {v:'ถุง',   mm:'အိတ်',   en:'Bag'},
  {v:'โหล',   mm:'ဒါဇင်',  en:'Dozen'}
];
function unitLabel(u){
  return lang==='th' ? u.v : u.mm + ' · ' + u.en;
}

let lang = localStorage.getItem('formLang') || 'th';

/* คืนข้อความตามภาษาที่เลือก (mm = พม่า + อังกฤษใต้) */
function t(k, vars){
  const e = T[k]; if(!e) return k;
  let main = lang==='th' ? e.th : e.mm;
  if(vars) Object.keys(vars).forEach(x => main = main.replace('%'+x, vars[x]));
  return main;
}
function tHtml(k, vars){
  const e = T[k]; if(!e) return k;
  if(lang==='th'){
    let s = e.th;
    if(vars) Object.keys(vars).forEach(x => s = s.replace('%'+x, vars[x]));
    return esc(s).replace('*','<span class="req">*</span>');
  }
  let m = e.mm, n = e.en;
  if(vars) Object.keys(vars).forEach(x => { m = m.replace('%'+x, vars[x]); n = n.replace('%'+x, vars[x]); });
  return esc(m).replace('*','<span class="req">*</span>')
       + '<span class="sub">' + esc(n).replace('*','') + '</span>';
}
/* ข้อความสำหรับ alert / placeholder (บรรทัดเดียว ไม่มี HTML) */
function tPlain(k){
  const e = T[k]; if(!e) return k;
  return lang==='th' ? e.th : e.mm + '\n' + e.en;
}
function tPh(k){
  const e = T[k]; if(!e) return '';
  return lang==='th' ? e.th : e.mm + ' · ' + e.en;
}

function applyLang(){
  document.body.classList.toggle('lang-mm', lang==='mm');
  document.documentElement.lang = lang==='th' ? 'th' : 'my';
  $('langtabs').querySelectorAll('button').forEach(b=>b.classList.toggle('on', b.dataset.l===lang));
  document.querySelectorAll('[data-k]').forEach(el => el.innerHTML = tHtml(el.dataset.k));
  document.querySelectorAll('[data-ph]').forEach(el => el.placeholder = tPh(el.dataset.ph));
  $('draftHint').textContent = tPh('draft');
  renderBill(); renderGoods(); renderItems(); recalc();
  localStorage.setItem('formLang', lang);
}
$('langtabs').querySelectorAll('button').forEach(b=>{
  b.onclick = () => { lang = b.dataset.l; applyLang(); };
});

/* ===================== รูป ===================== */
let billImgs = [], goodsImgs = [], items = [], carrier = '';

function compress(file, maxSide = 1600, quality = 0.72){
  return new Promise((resolve, reject) => {
    const fr = new FileReader();
    fr.onload = () => {
      const img = new Image();
      img.onload = () => {
        let w = img.width, h = img.height;
        const s = Math.min(1, maxSide / Math.max(w, h));
        w = Math.round(w*s); h = Math.round(h*s);
        const cv = document.createElement('canvas');
        cv.width = w; cv.height = h;
        cv.getContext('2d').drawImage(img, 0, 0, w, h);
        resolve(cv.toDataURL('image/jpeg', quality));
      };
      img.onerror = reject; img.src = fr.result;
    };
    fr.onerror = reject; fr.readAsDataURL(file);
  });
}
function photoSection(dropId, thumbsId, arr, tapKey, doneKey){
  $(dropId).onclick = () => {
    const inp = document.createElement('input');
    inp.type='file'; inp.accept='image/*'; inp.multiple=true;
    inp.onchange = async e => {
      for (const f of e.target.files) arr.push({name:f.name, dataUrl: await compress(f)});
      render(); saveDraft();
    };
    inp.click();
  };
  function render(){
    const box = $(thumbsId);
    box.innerHTML = arr.map((im,i)=>
      `<div class="thumb"><img src="${im.dataUrl}"><b data-i="${i}">×</b></div>`).join('');
    box.querySelectorAll('b').forEach(b => b.onclick = () => {
      arr.splice(+b.dataset.i,1); render(); saveDraft();
    });
    const d = $(dropId);
    d.classList.toggle('has', arr.length>0);
    if(!arr.length){ d.innerHTML = tHtml(tapKey); return; }
    d.innerHTML = lang==='th'
      ? `${T[doneKey].th} ${arr.length} ${T.more.th}`
      : `${T[doneKey].mm} ${arr.length} ${T.more.mm}<span class="sub">${T[doneKey].en} — ${arr.length} ${T.more.en}</span>`;
  }
  return render;
}
const renderBill = photoSection('billDrop','billThumbs',billImgs,'tapBill','doneBill');
const renderGoods = photoSection('goodsDrop','goodsThumbs',goodsImgs,'tapGoods','doneGoods');

/* ===================== บริษัทขนส่ง ===================== */
$('carrierSeg').querySelectorAll('button').forEach(b=>{
  b.onclick = () => {
    carrier = b.dataset.c;
    $('carrierSeg').querySelectorAll('button').forEach(x=>x.classList.toggle('on', x===b));
    saveDraft();
  };
});
function paintCarrier(){
  $('carrierSeg').querySelectorAll('button').forEach(x=>x.classList.toggle('on', x.dataset.c===carrier));
}

/* ===================== รายการสินค้า ===================== */
function addItem(d = {}){ items.push(Object.assign({code:'', size:'', qty:'', unit:'ห่อ', note:''}, d)); }

/* บรรทัดสรุปที่บันทึกลง Sheet — ภาษาไทยเสมอ */
function lineText(it){
  if(!it.code && !it.qty) return '';
  return [it.code, it.size, it.qty ? it.qty + ' ' + it.unit : ''].filter(Boolean).join(' ');
}
function renderItems(){
  $('items').innerHTML = items.map((it,i)=>`
    <div class="item ${it.code && it.qty ? 'done':''}" data-i="${i}">
      <div class="item-head">
        <span class="item-no">${esc(t('itemNo'))} ${i+1}</span>
        <button class="btn btn-d" data-del="${i}">${esc(t('del'))}</button>
      </div>
      <div class="row2">
        <div><label>${tHtml('code')}</label>
          <input data-f="code" data-i="${i}" list="codeList" class="fill"
                 value="${esc(it.code)}" placeholder="${esc(tPh('codePh'))}" autocomplete="off"></div>
        <div><label>${tHtml('size')}</label>
          <input data-f="size" data-i="${i}" list="sizeList" class="fill"
                 value="${esc(it.size)}" placeholder="M-6XL" autocomplete="off"></div>
      </div>
      <div class="qty" style="margin-top:11px">
        <div><label>${tHtml('qty')}</label>
          <input data-f="qty" data-i="${i}" type="number" step="1" min="0" inputmode="numeric"
                 class="fill" value="${esc(it.qty)}"></div>
        <div><label>${tHtml('unit')}</label>
          <select data-f="unit" data-i="${i}" class="fill">
            ${UNITS.map(u=>`<option value="${u.v}" ${it.unit===u.v?'selected':''}>${esc(unitLabel(u))}</option>`).join('')}
          </select></div>
      </div>
      <div style="margin-top:11px"><label>${tHtml('itemNote')}</label>
        <input data-f="note" data-i="${i}" class="fill" value="${esc(it.note)}" autocomplete="off"></div>
      <div class="preview" data-p="${i}">${esc(lineText(it))}</div>
    </div>`).join('');

  $('items').querySelectorAll('[data-f]').forEach(el=>{
    const upd = () => {
      const i = +el.dataset.i, it = items[i];
      it[el.dataset.f] = el.value;
      el.closest('.item').classList.toggle('done', !!(it.code && it.qty));
      const pv = $('items').querySelector(`[data-p="${i}"]`);
      if(pv) pv.textContent = lineText(it);
      recalc(); saveDraft();
    };
    el.oninput = upd; el.onchange = upd;
  });
  $('items').querySelectorAll('[data-del]').forEach(b=>{
    b.onclick = () => { items.splice(+b.dataset.del,1); renderItems(); recalc(); saveDraft(); };
  });
  mkList('codeList', items.map(i=>i.code));
  mkList('sizeList', ['S-XL','M-3XL','M-6XL','2XL-6XL','FREE SIZE'].concat(items.map(i=>i.size)));
}
function mkList(id, vals){
  let dl = $(id);
  if(!dl){ dl = document.createElement('datalist'); dl.id = id; document.body.appendChild(dl); }
  dl.innerHTML = [...new Set(vals.filter(Boolean))].map(v=>`<option value="${esc(v)}"></option>`).join('');
}

/* ===================== สรุป ===================== */
function recalc(){
  const filled = items.filter(i=>i.code || i.qty);
  const byUnit = {};
  filled.forEach(i=>{ byUnit[i.unit] = (byUnit[i.unit]||0) + (parseFloat(i.qty)||0); });
  $('sumLine').innerHTML = filled.length ? tHtml('sumN',{n:filled.length}) : tHtml('sumNone');
  $('sumList').innerHTML = Object.keys(byUnit).map(v=>{
    const u = UNITS.find(x=>x.v===v) || {v:v, mm:'', en:''};
    return `<li>${esc(unitLabel(u))} — <b>${byUnit[v].toLocaleString('en-US')}</b></li>`;
  }).join('');
}

/* ===================== ร่างในเครื่อง ===================== */
function saveDraft(){
  try{
    localStorage.setItem(DRAFT, JSON.stringify({
      billDate:$('billDate').value, billNo:$('billNo').value, carrier,
      worker:$('worker').value, note:$('note').value, items, billImgs, goodsImgs
    }));
    $('draftHint').textContent = tPh('draftAt') + ' ' + new Date().toLocaleTimeString('th-TH');
  }catch(e){ $('draftHint').textContent = tPh('draftFull'); }
}
function loadDraft(){
  try{
    const d = JSON.parse(localStorage.getItem(DRAFT)||'null');
    if(!d) return false;
    $('billDate').value = d.billDate||''; $('billNo').value = d.billNo||'';
    $('worker').value = d.worker||''; $('note').value = d.note||'';
    carrier = d.carrier||''; items = d.items||[];
    billImgs.push.apply(billImgs, d.billImgs||[]);
    goodsImgs.push.apply(goodsImgs, d.goodsImgs||[]);
    return true;
  }catch(e){ return false; }
}

/* ===================== ส่งข้อมูล ===================== */
async function post(payload){
  const res = await fetch(API_URL, {
    method:'POST',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify(payload)
  });
  const txt = await res.text();
  let out; try{ out = JSON.parse(txt); }catch(e){ throw new Error(txt.slice(0,120)); }
  if(!out.ok) throw new Error(out.error||'error');
  return out;
}

$('submit').onclick = async () => {
  if(API_URL.indexOf('http')!==0){ alert(tPlain('errUrl')); return; }
  if(!$('billDate').value){ alert(tPlain('errDate')); $('billDate').focus(); return; }
  if(!carrier){ alert(tPlain('errCarrier')); return; }
  if(!$('worker').value.trim()){ alert(tPlain('errWorker')); $('worker').focus(); return; }
  const filled = items.filter(i=>i.code || i.qty);
  if(!filled.length){ alert(tPlain('errItems')); return; }
  if(!billImgs.length && !confirm(tPlain('askBill'))) return;

  const btn = $('submit'); btn.disabled = true;
  const prog = $('prog'); prog.classList.add('show');
  try{
    prog.textContent = tPh('saving');
    const meta = await post({
      action:'createEntry',
      head:{ billDate:$('billDate').value, billNo:$('billNo').value.trim(),
             carrier, worker:$('worker').value.trim() },
      note:$('note').value,
      lang: lang,
      items: filled.map((it,i)=>({
        no:i+1, code:it.code, size:it.size, qty:it.qty, unit:it.unit,
        note:it.note, line:lineText(it)
      })),
      billPhotoCount: billImgs.length,
      goodsPhotoCount: goodsImgs.length
    });

    const jobs = [];
    billImgs.forEach((im,i)=> jobs.push({
      kind:'bill', idx:i+1, dataUrl:im.dataUrl,
      folderId: meta.billFolderId || meta.folderId }));
    goodsImgs.forEach((im,i)=> jobs.push({
      kind:'goods', idx:i+1, dataUrl:im.dataUrl,
      folderId: meta.goodsFolderId || meta.folderId }));

    for(let i=0;i<jobs.length;i++){
      prog.textContent = `${tPh('uploading')} ${i+1}/${jobs.length}`;
      await post({action:'uploadPhoto', entryId:meta.entryId,
                  folderId:jobs[i].folderId, photo:jobs[i]});
    }

    prog.textContent = tPh('doneAll');
    const r = $('result'); r.classList.add('show');
    r.innerHTML = `<h2>${tHtml('okTitle')}</h2>
      <div style="font-size:13px;color:#6b7688;margin-top:4px">
        ${esc(meta.entryId)} · ${esc(meta.timestamp)} · ${jobs.length} ${esc(t('photos'))}</div>
      <a href="${meta.folderUrl}" target="_blank" rel="noopener">${tHtml('lFolder')}</a>
      ${meta.billFolderUrl?`<a href="${meta.billFolderUrl}" target="_blank" rel="noopener">${tHtml('lBillFolder')}</a>`:''}
      ${meta.goodsFolderUrl?`<a href="${meta.goodsFolderUrl}" target="_blank" rel="noopener">${tHtml('lGoodsFolder')}</a>`:''}
      <a href="${meta.sheetUrl}" target="_blank" rel="noopener">${tHtml('lSheet')}</a>
      ${meta.pdfUrl?`<a href="${meta.pdfUrl}" target="_blank" rel="noopener">${tHtml('lPdf')}</a>`:''}
      ${meta.masterUrl?`<a href="${meta.masterUrl}" target="_blank" rel="noopener">${tHtml('lMaster')}</a>`:''}`;
    r.scrollIntoView({behavior:'smooth'});
    localStorage.removeItem(DRAFT);
    $('draftHint').textContent = tPh('sent');
  }catch(err){
    prog.textContent = '';
    alert(tPlain('errSend') + '\n\n' + err.message);
  }finally{
    btn.disabled = false;
    setTimeout(()=>prog.classList.remove('show'), 4000);
  }
};

/* ===================== ปุ่ม / เริ่มต้น ===================== */
$('addItem').onclick = () => { addItem(); renderItems(); recalc(); saveDraft(); };
$('add5').onclick = () => { for(let i=0;i<5;i++) addItem(); renderItems(); recalc(); saveDraft(); };
['billDate','billNo','worker','note'].forEach(id=> $(id).onchange = saveDraft);

if(!loadDraft()){
  $('billDate').value = new Date().toISOString().slice(0,10);
  addItem();
}
paintCarrier();
applyLang();
</script>
