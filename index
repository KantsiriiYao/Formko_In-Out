  del:{th:'ลบ', mm:'ဖျက်', en:'Delete'},
  code:{th:'รหัส / ชื่อสินค้า', mm:'ကုန်ပစ္စည်း ကုဒ် / အမည်', en:'Code / item name'},
  codePh:{th:'5207 หรือ ผ้า', mm:'5207 / အထည်', en:'5207 or Fabric'},
