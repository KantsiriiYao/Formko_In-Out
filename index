  submit:{th:'ส่งข้อมูล + อัพโหลดรูป', mm:'အချက်အလက်နှင့် ဓာတ်ပုံ ပို့ရန်', en:'Submit & upload photos'},
  draft:{th:'เก็บร่างในเครื่องอัตโนมัติ', mm:'စက်ထဲတွင် အလိုအလျောက် သိမ်းထားသည်', en:'Draft saved on this phone'},
  draftAt:{th:'เก็บร่างแล้ว', mm:'သိမ်းပြီး', en:'Draft saved'},
  draftFull:{th:'รูปเยอะเกินไป เก็บร่างไม่ได้ — กรุณากดส่ง', mm:'ဓာတ်ပုံများနေသည် — ပို့ပါ', en:'Too many photos to save draft — please submit'},
  saving:{th:'กำลังบันทึกข้อมูล...', mm:'သိမ်းဆည်းနေသည်...', en:'Saving...'},
  uploading:{th:'กำลังอัพโหลดรูป', mm:'ဓာတ်ပုံ တင်နေသည်', en:'Uploading photo'},
