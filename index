<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>บันทึกบิลขนส่ง</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600;700&family=Noto+Sans+Myanmar:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#1f3864; --navy2:#2f4f8f; --bg:#f4f6fa; --card:#fff;
  --line:#dfe4ee; --ink:#1b2333; --muted:#6b7688;
  --yellow:#fff8e1; --yline:#f0c96b; --ok:#1c8a4e; --bad:#c0392b;
  --radius:14px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:"Sarabun","Noto Sans Thai","Leelawadee UI",Tahoma,-apple-system,sans-serif;
  font-size:15px;line-height:1.5;padding-bottom:98px}
body.lang-mm{font-family:"Noto Sans Myanmar","Padauk","Myanmar Text","Sarabun",sans-serif;
  line-height:1.75}
.sub{display:block;font-size:11.5px;color:var(--muted);font-weight:400;
  font-family:"Sarabun",Tahoma,sans-serif;line-height:1.35;margin-top:1px}

header{background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;
  padding:14px 16px 12px;position:sticky;top:0;z-index:20;box-shadow:0 2px 10px rgba(0,0,0,.15)}
header h1{margin:0;font-size:18px;font-weight:700;line-height:1.35}
header h1 .sub{color:#b9cdf2;font-size:12.5px}
.langtabs{display:flex;gap:6px;margin-top:11px;background:rgba(255,255,255,.14);
  padding:4px;border-radius:11px}
.langtabs button{flex:1;border:0;background:transparent;color:#d7e3fa;font:inherit;
  font-size:14.5px;font-weight:700;padding:8px 4px;border-radius:8px;cursor:pointer}
.langtabs button.on{background:#fff;color:var(--navy)}

.wrap{max-width:900px;margin:0 auto;padding:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  padding:14px;margin-bottom:14px;box-shadow:0 1px 3px rgba(20,30,60,.05)}
.card h2{margin:0 0 12px;font-size:15.5px;color:var(--navy);display:flex;
  align-items:flex-start;gap:9px;line-height:1.35}
.card h2 .n{background:var(--navy);color:#fff;width:23px;height:23px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;font-size:12.5px;
  flex:0 0 auto;margin-top:1px;font-family:"Sarabun",Tahoma,sans-serif}
.card h2 .sub{color:#7d89a3}

label{display:block;font-size:12.5px;color:var(--muted);margin:0 0 5px;font-weight:600;line-height:1.35}
input,select,textarea{width:100%;padding:11px;border:1px solid var(--line);
  border-radius:10px;font:inherit;font-size:16px;background:#fff;color:var(--ink)}
input:focus,select:focus,textarea:focus{outline:2px solid var(--navy2);outline-offset:-1px;border-color:var(--navy2)}
.fill{background:var(--yellow);border-color:var(--yline)}
.grid{display:grid;gap:12px}
.g2{grid-template-columns:1fr 1fr}
.btn{border:0;border-radius:11px;padding:11px 16px;font:inherit;font-weight:600;
  cursor:pointer;font-size:14.5px}
.btn-p{background:var(--navy);color:#fff;width:100%;padding:13px;font-size:16px}
.btn-p .sub{color:#b9cdf2}
.btn-p:disabled{opacity:.55}
.btn-s{background:#eef1f7;color:var(--navy)}
.btn-d{background:#fdecea;color:var(--bad);padding:7px 13px;font-size:13px}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.seg{display:flex;gap:8px}
.seg button{flex:1;background:var(--yellow);border:1.5px solid var(--yline);border-radius:11px;
  padding:13px 6px;font-family:"Sarabun",Tahoma,sans-serif;font-weight:700;font-size:17px;
  color:var(--navy);cursor:pointer}
.seg button.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.drop{border:2px dashed var(--yline);background:var(--yellow);border-radius:12px;
  padding:20px 12px;text-align:center;color:#8a6d1f;font-size:14.5px;cursor:pointer;line-height:1.45}
.drop .sub{color:#a08348}
.drop.has{border-style:solid;border-color:#bfe3cd;background:#f6fcf8;color:var(--ok)}
.drop.has .sub{color:#4d9a72}
.thumbs{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
.thumb{position:relative;width:72px;height:72px;border-radius:9px;overflow:hidden;border:1px solid var(--line)}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb b{position:absolute;top:1px;right:1px;background:rgba(0,0,0,.65);color:#fff;
  width:20px;height:20px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-size:14px;cursor:pointer;font-weight:400}
.item{border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:10px;background:#fcfdff}
.item.done{border-color:#bfe3cd;background:#f6fcf8}
.item-head{display:flex;align-items:center;justify-content:space-between;
  gap:10px;margin-bottom:11px}
.item-no{font-weight:700;color:var(--navy);font-size:14.5px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.qty{display:grid;grid-template-columns:1fr 1.15fr;gap:11px}
.preview{margin-top:10px;padding:10px 12px;background:#eef1f7;border-radius:9px;
  font-size:15px;font-weight:700;color:var(--navy);min-height:40px;
  font-family:"Sarabun",Tahoma,sans-serif}
.sum{background:#f4f7fc;border-radius:11px;padding:12px}
.sum b{font-size:16px;color:var(--navy)}
.sum ul{margin:7px 0 0;padding-left:20px;font-size:14.5px}
.bar{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);
  padding:10px 16px calc(10px + env(safe-area-inset-bottom,0));z-index:30;
  box-shadow:0 -2px 12px rgba(20,30,60,.08)}
.bar .wrap{padding:0}
.hint{font-size:11.5px;color:var(--muted);margin-top:5px;text-align:center}
.result{display:none}
.result.show{display:block;background:#eaf7ef;border-color:#bfe3cd}
.result h2{color:var(--ok)}
.result a{display:block;background:#fff;border:1px solid #bfe3cd;border-radius:10px;
  padding:12px;margin-top:9px;color:var(--navy);text-decoration:none;font-weight:600;word-break:break-all}
.prog{display:none;font-size:13px;color:var(--muted);text-align:center;margin-top:7px}
.prog.show{display:block}
.req{color:var(--bad)}
</style>
</head>
<body>

<header>
  <h1 data-k="appTitle"></h1>
  <div class="langtabs" id="langtabs">
    <button type="button" data-l="th">ไทย</button>
    <button type="button" data-l="mm">မြန်မာ / EN</button>
  </div>
</header>

<div class="wrap">

  <div class="card">
    <h2><span class="n">1</span><span data-k="s1"></span></h2>
    <div class="grid g2">
      <div><label data-k="billDate"></label><input id="billDate" type="date" class="fill"></div>
      <div><label data-k="billNo"></label><input id="billNo" class="fill" data-ph="billNoPh" autocomplete="off"></div>
    </div>
    <div style="margin-top:12px">
      <label data-k="carrier"></label>
      <div class="seg" id="carrierSeg">
        <button type="button" data-c="CMT">CMT</button>
        <button type="button" data-c="GCL">GCL</button>
      </div>
    </div>
    <div style="margin-top:12px">
      <label data-k="worker"></label>
      <input id="worker" class="fill" data-ph="workerPh" autocomplete="off">
    </div>
  </div>

  <div class="card">
    <h2><span class="n">2</span><span data-k="s2"></span></h2>
    <div class="drop" id="billDrop"></div>
    <div class="thumbs" id="billThumbs"></div>
  </div>

  <div class="card">
    <h2><span class="n">3</span><span data-k="s3"></span></h2>
    <div class="drop" id="goodsDrop"></div>
    <div class="thumbs" id="goodsThumbs"></div>
  </div>

  <div class="card">
    <h2><span class="n">4</span><span data-k="s4"></span></h2>
    <div class="btn-row">
      <button class="btn btn-s" id="addItem" data-k="addItem"></button>
      <button class="btn btn-s" id="add5" data-k="add5"></button>
    </div>
    <div id="items"></div>
  </div>

  <div class="card">
    <h2><span class="n">5</span><span data-k="s5"></span></h2>
    <textarea id="note" rows="3" class="fill" data-ph="notePh"></textarea>
    <div class="sum" style="margin-top:12px">
      <b id="sumLine"></b>
      <ul id="sumList"></ul>
    </div>
  </div>

  <div class="result card" id="result"></div>
</div>

<div class="bar">
  <div class="wrap">
    <button class="btn btn-p" id="submit" data-k="submit"></button>
    <div class="prog" id="prog"></div>
    <div class="hint" id="draftHint"></div>
  </div>
</div>

<script>
/* ========= ตั้งค่า: ใส่ URL ของ Apps Script Web App ตรงนี้ ========= */
const API_URL = "PASTE_YOUR_APPS_SCRIPT_WEB_APP_URL_HERE";
/* ================================================================= */

const $ = id => document.getElementById(id);
const DRAFT = 'shipmentDraft_v3';
const esc = s => String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

/* ===================== ภาษา =====================
   th = ไทยล้วน   |   mm = พม่า + อังกฤษกำกับใต้
   ค่าที่บันทึกลง Google Sheet เป็นชุดเดียวกันเสมอ (ภาษาไทย)
   ================================================ */
const T = {
